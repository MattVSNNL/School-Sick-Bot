PORT=3000
TIME_ZONE=Europe/Amsterdam
EARLIEST_TODAY=06:00
TODAY_CUTOFF=09:30
SKIP_WEEKENDS=true

# Generate a long random value and put the same value in the iPhone Shortcut.
SICK_API_KEY=replace-with-at-least-32-random-characters

FORM_URL=https://forms.cloud.microsoft/pages/responsepage.aspx?id=RswIyUxVMUGGU0VSLmjikRAt-y7bYjBDvR5iyEwa7gpUMVA4WTZXUkY3WUJLTVk0TFRFTUY2RDhQSi4u
STUDENT_NUMBER=
FIRST_NAME=
LAST_NAME=
BIRTH_DATE=2000-01-31
PROGRAMME=Software Developer niveau 4
APPLICANT=Student
PHONE_NUMBER=
WANTS_PHONE_CONTACT=Nee

# Keep false until the local dry run succeeds and the live form has been checked.
SUBMIT_ENABLED=false

# Mount a Railway volume at /data and set this to /data/jobs.json for durable pre-06:00 scheduling.
DATA_FILE=.data/jobs.json

# Optional: receive a Discord message after every successful or failed submission.
DISCORD_WEBHOOK_URL=
